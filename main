loadstring(game:HttpGet("https://raw.githubusercontent.com/KATERGaming/Roblox/main/KaterHub.Lua"))()
--system
local Network = require(game:GetService("ReplicatedStorage").Framework.Modules.Client["2 - Network"])
local localPlayer = game:GetService("Players").LocalPlayer
local ReplicatedStorage = game:GetService("ReplicatedStorage")

--bypass
hookfunction(debug.getupvalue(Network.Invoke, 1), function(...) return true end)
hookfunction(debug.getupvalue(Network.Fired, 1), function(...) return true end)

getgenv().autoegg = true
while getgenv().autoegg do
Network.Invoke("Buy Egg", "Cursed Egg", true)
Network.Invoke("Buy Egg", "Cursed Egg", false)
task.wait()
end
